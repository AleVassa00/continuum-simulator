services:

{{range .CloudWorkers}}  {{.WorkerID}}:
    image: "continuum-cloud-worker:${DEPLOYMENT_ID:?DEPLOYMENT_ID is required}"
    container_name: {{.WorkerID}}
    cpus: "${CLOUD_WORKER_CPUS:?resource profile is required}"
    mem_limit: "${CLOUD_WORKER_MEMORY:?resource profile is required}"
    memswap_limit: "${CLOUD_WORKER_MEMORY:?resource profile is required}"

    environment:
      KAFKA_BROKER: "${CLOUD_KAFKA_HOST}:9092"
      KAFKA_INPUT_TOPIC: "edge-aggregates"
      KAFKA_OUTPUT_TOPIC: "cloud-partition-aggregates"
      KAFKA_GROUP_ID: "cloud-workers"
      CLOUD_WINDOW_SIZE: "{{$.CloudWindowSize}}"
      CLOUD_WATERMARK_DELAY: "{{$.CloudWatermarkDelay}}"
      SOURCE_PARTITION_COUNT: "6"
      WORKER_ID: "{{.WorkerID}}"

    restart: "no"

{{end}}
