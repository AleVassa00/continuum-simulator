services:

  partition-coordinator:
    image: "continuum-edge:${DEPLOYMENT_ID:?DEPLOYMENT_ID is required}"
    container_name: partition-coordinator
    entrypoint: ["/app/partition-coordinator"]
    cpus: "${COORDINATOR_CPUS:-0.1}"
    mem_limit: "${COORDINATOR_MEMORY:-64m}"
    memswap_limit: "${COORDINATOR_MEMORY:-64m}"
    environment:
      KAFKA_BROKER: "${CLOUD_KAFKA_HOST}:9092"
      KAFKA_TOPIC: "edge-aggregates"
      COORDINATOR_EXPECTED_EDGE_IDS: "{{.ExpectedEdgeIDs}}"
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O - http://localhost:8081/readyz >/dev/null 2>&1"]
      interval: 2s
      timeout: 1s
      retries: 15
    restart: "no"
    networks:
      - edge-completion

{{range .Edges}}  # {{.EdgeID}}: {{.SensorCount}} sensors
  {{.MQTTService}}:
    image: "continuum-mosquitto:${DEPLOYMENT_ID:?DEPLOYMENT_ID is required}"
    container_name: {{.MQTTService}}
    cpus: "${MQTT_CPUS:?resource profile is required}"
    mem_limit: "${MQTT_MEMORY:?resource profile is required}"
    memswap_limit: "${MQTT_MEMORY:?resource profile is required}"
    ports:
      - "{{.MQTTPort}}:1883"
    volumes:
      - ../../mosquitto/mosquitto.conf:/mosquitto/config/mosquitto.conf:ro
    healthcheck:
      test: ["CMD", "mosquitto_pub", "-h", "localhost", "-p", "1883", "-t", "healthcheck", "-m", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10
    restart: unless-stopped
    networks:
      - {{.ZoneNetwork}}

  {{.EdgeID}}:
    image: "continuum-edge:${DEPLOYMENT_ID:?DEPLOYMENT_ID is required}"
    container_name: {{.EdgeID}}
    cpus: "${EDGE_CPUS:?resource profile is required}"
    mem_limit: "${EDGE_MEMORY:?resource profile is required}"
    memswap_limit: "${EDGE_MEMORY:?resource profile is required}"
    environment:
      EDGE_ID: "{{.EdgeID}}"
      MQTT_BROKER: "tcp://{{.MQTTService}}:1883"
      WINDOW_SIZE: "{{$.EdgeWindowSize}}"
      EDGE_INGRESS_QUEUE_CAPACITY: "{{$.EdgeIngressQueueCapacity}}"
      KAFKA_BROKER: "${CLOUD_KAFKA_HOST}:9092"
      KAFKA_TOPIC: "edge-aggregates"
      EDGE_COMPLETION_URL: "http://partition-coordinator:8081/completed"
    depends_on:
      {{.MQTTService}}:
        condition: service_healthy
      partition-coordinator:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O - http://localhost:8080/readyz >/dev/null 2>&1"]
      interval: 2s
      timeout: 1s
      retries: 15
    restart: "no"
    networks:
      - {{.ZoneNetwork}}
      - edge-completion

{{end}}networks:
  edge-completion:
    driver: bridge
{{range .Edges}}  zone-{{.EdgeID}}:
    driver: bridge
{{end}}
