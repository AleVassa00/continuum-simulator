# Copiare come deploy/pilot.env e compilare i valori locali.
# deploy/pilot.env e ignorato da Git.

SSH_USER=ec2-user
SSH_KEY_PATH=/home/user/.ssh/aws-key.pem

AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

TF_VAR_rds_password=

RESOURCE_PROFILE=deploy/resources/aws-pilot.env

# Opzionali
SSH_WAIT_ATTEMPTS=60
SSH_WAIT_INTERVAL_SECONDS=5
TIME_SYNC_ATTEMPTS=24
KAFKA_READY_TIMEOUT_SECONDS=300
EDGE_READY_TIMEOUT_SECONDS=300
RUN_COMPLETION_TIMEOUT_SECONDS=3600
POLL_INTERVAL_SECONDS=2
METRICS_INTERVAL_SECONDS=5
